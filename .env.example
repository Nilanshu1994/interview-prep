# ─── Copy this file to .env and fill in your values ──────────────────────────

# Supabase — free cloud database (supabase.com → your project → Settings → API)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# GitHub Models — free AI question generation
# Get from: https://github.com/settings/tokens/new (no scopes needed)
REACT_APP_GH_TOKEN=ghp_your_token_here

# Admin PIN — only YOU know this, lets you add/delete topics on the public app
# Pick any 4-8 digit number. Example: 7291
REACT_APP_ADMIN_PIN=your_pin_here
