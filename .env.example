# ─── Copy this file to .env and fill in your values ──────────────────────────

# Supabase — free cloud database (supabase.com → your project → Settings → API)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Worker proxy URL — get this after deploying cloudflare-worker/
# See cloudflare-worker/README.md for setup (5 min, free)
# Format: https://interview-prep-proxy.YOUR_SUBDOMAIN.workers.dev
REACT_APP_PROXY_URL=https://your-worker.your-subdomain.workers.dev

# Admin PIN — only you know this, protects add/delete on the public page
REACT_APP_ADMIN_PIN=your_pin_here
